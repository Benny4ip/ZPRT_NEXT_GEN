<Window x:Class="ZprtNextGen.App.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Мой пресет"
        Width="560" Height="520"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource DarkWindow}"
        Loaded="OnLoaded">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Мой пресет" FontSize="20" FontWeight="Bold"
               Foreground="{StaticResource Brush.Text}" Margin="0,0,0,16" />

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" VerticalAlignment="Center"
                 Foreground="{StaticResource Brush.Text}" Margin="0,0,12,10" />
      <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1"
               Style="{StaticResource DarkTextBox}" Margin="0,0,0,10" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Описание" VerticalAlignment="Center"
                 Foreground="{StaticResource Brush.Text}" Margin="0,0,12,0" />
      <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1"
               Style="{StaticResource DarkTextBox}" />
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Аргументы" VerticalAlignment="Top"
                 Foreground="{StaticResource Brush.Text}" Margin="0,6,12,0" />
      <TextBox x:Name="ArgsBox" Grid.Column="1"
               Style="{StaticResource DarkTextBox}"
               AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               FontFamily="Cascadia Mono, Consolas" FontSize="12" />
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="Подсказка: используй {{GameFilterTCP}} и {{GameFilterUDP}} — приложение подставит нужные порты игрового профиля."
                 Foreground="{StaticResource Brush.TextMuted}" FontSize="12" TextWrapping="Wrap" />
      <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12"
                 TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Click="OnCancel" Style="{StaticResource SecondaryButton}"
              MinWidth="100" Padding="12,6" Margin="0,0,10,0" />
      <Button Content="Сохранить" Click="OnSave" Style="{StaticResource PrimaryButton}"
              MinWidth="120" Padding="12,6" />
    </StackPanel>
  </Grid>
</Window>
