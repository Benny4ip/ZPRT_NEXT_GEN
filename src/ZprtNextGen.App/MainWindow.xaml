<Window x:Class="ZprtNextGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:clr="clr-namespace:ZprtNextGen.App.Controls"
        xmlns:conv="clr-namespace:ZprtNextGen.App.Converters"
        xmlns:presets="clr-namespace:ZprtNextGen.Core.Presets;assembly=ZprtNextGen.Core"
        mc:Ignorable="d"
        Title="ZPRT NEXT GEN"
        Width="1100" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DarkWindow}"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Герой: визуализация состояния + управление обходом. -->
        <Grid x:Name="HeroPanel" Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <clr:MeditationView Grid.Column="0" Width="280" Height="280"
                                State="{Binding AnimationState}" ReduceMotion="{Binding ReduceMotion}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ZPRT NEXT GEN" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Brush.Text}" />
                <ContentControl Style="{StaticResource StatusPill}" Content="{Binding StatusText}" Margin="0,10,0,0" />
                <Button x:Name="ToggleButton"
                        Command="{Binding ToggleCommand}"
                        IsEnabled="{Binding CanStart}"
                        MinWidth="240" Height="44"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0"
                        Content="Включить обход">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Выключить обход" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="Discord · YouTube · без лишних окон"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>

        <!-- Пресеты (заполняется в Task 16). -->
        <ContentControl x:Name="PresetHost" Grid.Row="1" Margin="0,0,0,16" />

        <!-- Связь и лог. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" x:Name="ConnectivityPanel" Grid.Column="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Связь с сервисами" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding ConnectivityRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,7" CornerRadius="8" SnapsToDevicePixels="True">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="10" Height="10"
                                                 Fill="{Binding Success, Converter={StaticResource BoolToBrushConverter}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ElapsedMs, StringFormat='{}{0} мс'}"
                                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="Проверить связь"
                                                Command="{Binding TestConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4"
                                                Margin="12,0,0,0" MinWidth="110" VerticalAlignment="Center">
                                            <Button.ToolTip>
                                                <ToolTip Content="{Binding Error}"
                                                         Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Button.ToolTip>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="LogPanel" Grid.Column="1" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Лог" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" Margin="0,0,0,8" />
                    <Button DockPanel.Dock="Bottom" Content="Открыть папку логов"
                            Command="{Binding OpenLogsCommand}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" MinWidth="110" Padding="10,4" />
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             Style="{StaticResource LogListBox}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Подвал: настройки. -->
        <Expander x:Name="SettingsPanel" Grid.Row="3" Header="Настройки"
                  Style="{StaticResource SettingsExpander}" Foreground="{StaticResource Brush.Text}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Папка движка" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding EnginePath, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource DarkTextBox}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Обзор…" Click="OnBrowseEngine"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Margin="10,0,0,0" MinWidth="80" Padding="10,4" />
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Игровой фильтр" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                              SelectedValue="{Binding GameFilter, Mode=TwoWay}"
                              SelectedValuePath="Tag" DisplayMemberPath="Content"
                              MinWidth="140" VerticalAlignment="Center">
                        <ComboBoxItem Content="Выключен" Tag="{x:Static presets:GameFilterMode.Disabled}" />
                        <ComboBoxItem Content="TCP" Tag="{x:Static presets:GameFilterMode.Tcp}" />
                        <ComboBoxItem Content="UDP" Tag="{x:Static presets:GameFilterMode.Udp}" />
                        <ComboBoxItem Content="Все" Tag="{x:Static presets:GameFilterMode.All}" />
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsAutostartEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    <TextBlock Text="Автозапуск" Foreground="{StaticResource Brush.Text}"
                               VerticalAlignment="Center" Margin="8,0,16,0" />
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    <TextBlock Text="Сворачивать в трей" Foreground="{StaticResource Brush.Text}"
                               VerticalAlignment="Center" Margin="8,0,16,0" />
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    <TextBlock Text="Уменьшить анимацию" Foreground="{StaticResource Brush.Text}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <Button x:Name="AboutButton" Content="О программе" Click="OnAbout"
                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        MinWidth="100" Padding="10,4" />
            </StackPanel>
        </Expander>
    </Grid>
</Window>
