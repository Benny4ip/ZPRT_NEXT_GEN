<Window x:Class="ZprtNextGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:clr="clr-namespace:ZprtNextGen.App.Controls"
        xmlns:conv="clr-namespace:ZprtNextGen.App.Converters"
        xmlns:presets="clr-namespace:ZprtNextGen.Core.Presets;assembly=ZprtNextGen.Core"
        mc:Ignorable="d"
        Title="ZPRT NEXT GEN"
        Width="1100" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DarkWindow}"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Герой: визуализация состояния + управление обходом. -->
        <Grid x:Name="HeroPanel" Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <clr:MeditationView Grid.Column="0" Width="280" Height="280"
                                State="{Binding AnimationState}" ReduceMotion="{Binding ReduceMotion}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                <TextBlock Text="ZPRT NEXT GEN" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Brush.Text}" />
                <ContentControl Style="{StaticResource StatusPill}" Content="{Binding StatusText}" Margin="0,10,0,0" />
                <Button x:Name="ToggleButton"
                        Command="{Binding ToggleCommand}"
                        IsEnabled="{Binding CanStart}"
                        MinWidth="240" Height="44"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Включить обход" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Выключить обход" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="Discord · YouTube · без лишних окон"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="0,16,0,0" />
            </StackPanel>

            <Button Grid.Column="2" Content="&#x2699;"
                    FontFamily="Segoe UI Symbol" FontSize="20"
                    Style="{StaticResource IconButton}"
                    Click="OnSettings"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    Margin="12,0,16,0" ToolTip="Настройки" />
        </Grid>

        <!-- Пресеты: сгруппированный селектор (Task 16). -->
        <clr:PresetSelector Grid.Row="1" Margin="0,0,0,16"
                            Groups="{Binding Groups}"
                            SelectedPreset="{Binding SelectedPreset, Mode=TwoWay}"
                            SelectCommand="{Binding SelectPresetCommand}" />

        <!-- Связь и лог. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" x:Name="ConnectivityPanel" Grid.Column="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Связь с сервисами" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" Margin="0,0,0,12" />
                    <ScrollViewer Style="{StaticResource DarkScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ConnectivityRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,7" CornerRadius="8" SnapsToDevicePixels="True">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                     Fill="{Binding Success, Converter={StaticResource BoolToBrushConverter}}"
                                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElapsedMs, StringFormat='{}{0} мс'}"
                                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Проверить связь"
                                                    Command="{Binding TestConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4"
                                                    Margin="12,0,0,0" MinWidth="110" VerticalAlignment="Center">
                                                <Button.ToolTip>
                                                    <ToolTip Content="{Binding Error}"
                                                             Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Button.ToolTip>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="LogPanel" Grid.Column="1" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Лог" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" Margin="0,0,0,8" />
                    <Button DockPanel.Dock="Bottom" Content="Открыть папку логов"
                            Command="{Binding OpenLogsCommand}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" MinWidth="110" Padding="10,4" />
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             Style="{StaticResource LogListBox}" />
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
