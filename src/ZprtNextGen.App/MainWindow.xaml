<Window x:Class="ZprtNextGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:clr="clr-namespace:ZprtNextGen.App.Controls"
        xmlns:conv="clr-namespace:ZprtNextGen.App.Converters"
        mc:Ignorable="d"
        Title="ZPRT NEXT GEN"
        Width="760" Height="720"
        MinWidth="640" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DarkWindow}"
        Loaded="OnLoaded"
        Closing="OnClosing">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

    <!-- Донат: outline-кнопка с золотым акцентом. -->
    <Style x:Key="DonateButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Foreground" Value="#F5C75C" />
      <Setter Property="BorderBrush" Value="#6B5320" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Кнопка-действие под орбом. -->
    <Style x:Key="OrbActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="6,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="24,18,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Верх: название слева, донат справа. -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="ZPRT NEXT GEN" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
      </StackPanel>

      <Button Grid.Column="1"
              Style="{StaticResource DonateButton}"
              Command="{Binding DonateCommand}"
              ToolTip="Поддержи проект денежкой"
              AutomationProperties.Name="Поддержи проект денежкой">
        <StackPanel Orientation="Horizontal">
          <Path Data="M 8,14 C 2,9 0,6 0,4 A 4,4 0 0 1 8,2 A 4,4 0 0 1 16,4 C 16,6 14,9 8,14 Z"
                Fill="#F5C75C" Width="16" Height="14" Stretch="Uniform"
                Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="Поддержи проект денежкой" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Центр: плашка подбора, орб, статусы и действия. -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

      <!-- Плашка первого подбора / восстановления профиля. -->
      <Border x:Name="SelectionBanner"
              Background="#1A1A1A" BorderBrush="#3A2A12" BorderThickness="1"
              CornerRadius="12" Padding="18,12" Margin="0,0,0,14" MaxWidth="520"
              Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="{Binding BannerTitle}" FontWeight="SemiBold" FontSize="14"
                     Foreground="#F5C75C" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding BannerText}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <clr:ConnectionOrb
          x:Name="Orb"
          HorizontalAlignment="Center"
          State="{Binding State}"
          MainText="{Binding OrbTitle}"
          HintText="{Binding OrbHint}"
          AutomationName="{Binding OrbAutomationName}"
          Progress="{Binding Progress}"
          ReduceMotion="{Binding ReduceMotion}"
          Command="{Binding ToggleCommand}" />

      <TextBlock x:Name="StatusTitle" Text="{Binding StatusTitle}"
                 FontSize="22" FontWeight="SemiBold"
                 Foreground="{StaticResource Brush.Text}"
                 TextAlignment="Center" TextWrapping="Wrap"
                 HorizontalAlignment="Center" Margin="0,18,0,0" MaxWidth="560" />

      <TextBlock Text="{Binding ProfileText}" FontSize="13"
                 Foreground="{StaticResource Brush.TextMuted}"
                 TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ProfileText}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <TextBlock Text="{Binding ProgressText}" FontSize="13"
                 Foreground="{StaticResource Brush.TextMuted}"
                 TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0" />

      <!-- Действия во время подбора / после ошибки. -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
        <Button Content="Остановить и применить лучший"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding StopAndApplyBestCommand}"
                Padding="16,8" Margin="0"
                Visibility="{Binding CanStopAndApply, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Button Content="Отмена"
                Style="{StaticResource OrbActionButton}"
                Command="{Binding CancelSelectionCommand}"
                Visibility="{Binding CanCancelSelection, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Button Content="Попробовать снова"
                Style="{StaticResource OrbActionButton}"
                Command="{Binding RetryCommand}"
                Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Button Content="Открыть настройки"
                Style="{StaticResource OrbActionButton}"
                Command="{Binding OpenSettingsCommand}"
                Visibility="{Binding ShowEngineSettingsHint, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>
    </StackPanel>

    <!-- Низ: Fix Discord слева, настройки справа. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding FixDiscordCommand}"
              Padding="14,8"
              ToolTip="Починить вечную загрузку Discord (сброс кэша без выхода из аккаунта)"
              AutomationProperties.Name="Fix Discord">
        <StackPanel Orientation="Horizontal">
          <Path Data="M 2,14 L 10,6 M 6,2 L 14,10 M 3,3 A 5,5 0 0 1 11,8 L 7,12 A 5,5 0 0 1 3,3 Z"
                Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.6"
                Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FixDiscordText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button Grid.Column="2"
              Style="{StaticResource IconButton}"
              Command="{Binding OpenSettingsCommand}"
              ToolTip="Настройки"
              AutomationProperties.Name="Настройки">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="30"
                     VerticalAlignment="Center" />
          <TextBlock Text="Настройки" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"
                     Foreground="{StaticResource Brush.TextMuted}" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>

