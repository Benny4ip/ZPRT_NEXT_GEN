<Window x:Class="ZprtNextGen.App.EngineUpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление движка"
        Width="460" Height="220"
        MinWidth="460" MinHeight="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource DarkWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Обновление запрета (движок)"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.Text}" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="StatusText" Text="Проверка обновлений…"
                       Foreground="{StaticResource Brush.TextMuted}" FontSize="13"
                       Margin="0,0,0,10" TextWrapping="Wrap" />
            <ProgressBar x:Name="ProgressBar" Height="8" IsIndeterminate="True"
                         Foreground="{StaticResource Brush.Enlightenment}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="OpenGitHubButton" Content="Открыть релизы движка" Visibility="Collapsed"
                    Click="OnOpenGitHub"
                    Style="{StaticResource SecondaryButton}" MinWidth="140" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Закрыть"
                    Click="OnClose"
                    Style="{StaticResource SecondaryButton}" MinWidth="100" Padding="10,4" />
        </StackPanel>
    </Grid>
</Window>
