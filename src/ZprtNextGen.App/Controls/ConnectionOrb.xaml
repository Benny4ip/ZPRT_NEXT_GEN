<UserControl x:Class="ZprtNextGen.App.Controls.ConnectionOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             Width="320" Height="320"
             Focusable="False"
             AutomationProperties.Name="{Binding AutomationName, ElementName=Root}">
  <Grid Width="320" Height="320" Background="Transparent">

    <!-- Мягкое свечение под диском. -->
    <Ellipse x:Name="Glow" Width="290" Height="290" Opacity="0.55">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop x:Name="GlowCenter" Color="#33E01B2E" Offset="0.55" />
          <GradientStop Color="#00E01B2E" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
      <Ellipse.Effect>
        <BlurEffect Radius="36" />
      </Ellipse.Effect>
    </Ellipse>

    <!-- Индикатор прогресса: кольцо вокруг орба. -->
    <Ellipse Width="296" Height="296" Stroke="#222222" StrokeThickness="3" />
    <Path x:Name="ProgressArc" Stroke="#F5A524" StrokeThickness="6"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Visibility="Collapsed" />

    <Button x:Name="OrbButton"
            Command="{Binding Command, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}"
            Cursor="Hand"
            Focusable="True"
            IsTabStop="True"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            AutomationProperties.Name="{Binding AutomationName, ElementName=Root}"
            AutomationProperties.HelpText="{Binding HintText, ElementName=Root}">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Grid Width="250" Height="250" Background="Transparent">
            <Ellipse x:Name="Disc" Width="250" Height="250" StrokeThickness="2">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop x:Name="DiscInner" Color="#2A0F12" Offset="0" />
                  <GradientStop x:Name="DiscOuter" Color="#141414" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
              <Path x:Name="Check"
                    Data="M 0,12 L 11,23 L 34,0"
                    Stroke="#22C55E" StrokeThickness="6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Width="34" Height="23" Stretch="Uniform"
                    HorizontalAlignment="Center" Margin="0,0,0,10"
                    Opacity="0" Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1" />
                </Path.RenderTransform>
              </Path>

              <TextBlock x:Name="MainLabel"
                         Text="{Binding MainText, ElementName=Root}"
                         FontSize="21" FontWeight="SemiBold"
                         Foreground="#EDEDED"
                         TextAlignment="Center" TextWrapping="Wrap"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <Ellipse x:Name="FocusRing" Width="254" Height="254"
                     Stroke="#EDEDED" StrokeThickness="2" Opacity="0"
                     StrokeDashArray="4 3" IsHitTestVisible="False" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Disc" Property="Opacity" Value="0.92" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Disc" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="0.75" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</UserControl>
