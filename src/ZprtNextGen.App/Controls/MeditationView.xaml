<UserControl x:Class="ZprtNextGen.App.Controls.MeditationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="280" d:DesignHeight="280"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Остановлено: линия дышит 0.40↔0.60 (4 с), мягкое красное свечение. -->
        <Storyboard x:Key="StoppedStoryboard">
            <DoubleAnimation Storyboard.TargetName="BreathTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-3" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseLine" Storyboard.TargetProperty="Opacity"
                             From="0.40" To="0.60" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Сброс состояния, оставленного другими раскадровками. -->
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="PulseGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ProgressArc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="EndDotLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ErrorFlash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4" />
        </Storyboard>

        <!-- Подключение: линия оживает, свечение пульсирует, точка ещё скрыта. -->
        <Storyboard x:Key="ConnectingStoryboard">
            <DoubleAnimation Storyboard.TargetName="BreathTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-2" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseLine" Storyboard.TargetProperty="Opacity"
                             From="0.70" To="1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0.34" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
            <!-- Сброс «подключённого» и «ошибочного» состояния. -->
            <DoubleAnimation Storyboard.TargetName="PulseGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ProgressArc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="EndDotLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ErrorFlash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4" />
        </Storyboard>

        <!-- Подключено: золотая дуга и точка, линия и свечение дышат спокойно. -->
        <Storyboard x:Key="ConnectedStoryboard">
            <DoubleAnimation Storyboard.TargetName="BreathTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-5" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.03" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.03" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseLine" Storyboard.TargetProperty="Opacity"
                             From="0.85" To="1" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                             To="0.34" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="PulseGlow" Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.45" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ProgressArc" Storyboard.TargetProperty="Opacity"
                             To="0.75" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="EndDotLayer" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="EndDotGlow" Storyboard.TargetProperty="Opacity"
                             From="0.10" To="0.35" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ErrorFlash" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.4" />
        </Storyboard>

        <!-- Ошибка: короткая красная вспышка, линия гаснет. -->
        <Storyboard x:Key="ErrorStoryboard">
            <DoubleAnimation Storyboard.TargetName="ErrorFlash" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.28" Duration="0:0:0.22" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="BreathTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="PulseLine" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="PulseGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ProgressArc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="EndDotLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4" />
        </Storyboard>

        <!-- Мерцание линии: короткие вспышки, цикл ~2.2 с. -->
        <Storyboard x:Key="ShimmerStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PulseShimmer" Storyboard.TargetProperty="Opacity"
                                           RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.5" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.35" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0.35" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.15" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Форма линии сигнала: ровная полоса с коротким импульсом по центру. -->
        <PathGeometry x:Key="PulseGeometry"
                      Figures="M64,140 H104 L114,106 L130,174 L144,128 L154,140 H216" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <!-- Фон прозрачный: цвет окна #0A0A0A виден насквозь. -->
        <Canvas Width="280" Height="280" Background="{x:Null}">

            <Canvas x:Name="BreathRoot">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="BreathTransform" Y="0" />
                        <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"
                                        CenterX="140" CenterY="140" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Мягкое красное свечение под линией. -->
                <Ellipse x:Name="Glow" Width="208" Height="208" Canvas.Left="36" Canvas.Top="36"
                         Opacity="0.14" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#E01B2E" Offset="0" />
                            <GradientStop Color="#00E01B2E" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Две тонкие окружности вместо ромба. -->
                <Ellipse Width="192" Height="192" Canvas.Left="44" Canvas.Top="44"
                         Stroke="#242424" StrokeThickness="1" Fill="Transparent" />
                <Ellipse Width="140" Height="140" Canvas.Left="70" Canvas.Top="70"
                         Stroke="#1D1D1D" StrokeThickness="1" Fill="Transparent" />

                <!-- Золотая обводка-кольцо (полоса прогресса вокруг пульса). -->
                <Path x:Name="ProgressArc"
                      Stroke="#FFC65C" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0" IsHitTestVisible="False" />

                <!-- Свечение и чёткий контур линии сигнала. -->
                <Path Data="{StaticResource PulseGeometry}"
                      Stroke="#FF3B4E" StrokeThickness="9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Opacity="0" x:Name="PulseGlow" IsHitTestVisible="False">
                    <Path.Effect>
                        <BlurEffect Radius="9" />
                    </Path.Effect>
                </Path>
                <Path Data="{StaticResource PulseGeometry}"
                      Stroke="#FF3B4E" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Opacity="0.5" x:Name="PulseLine" />

                <!-- Мерцание поверх линии сигнала. -->
                <Path Data="{StaticResource PulseGeometry}"
                      Stroke="#FFFFFF" StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Opacity="0" x:Name="PulseShimmer" IsHitTestVisible="False" />

                <!-- Золотая точка на конце линии. -->
                <Canvas x:Name="EndDotLayer" Opacity="0">
                    <Ellipse x:Name="EndDotGlow" Width="26" Height="26"
                             Canvas.Left="203" Canvas.Top="127" Fill="#FFC65C" Opacity="0.16" />
                    <Ellipse Width="9" Height="9" Canvas.Left="211.5" Canvas.Top="135.5" Fill="#FFC65C" />
                </Canvas>
            </Canvas>

            <!-- Вспышка ошибки поверх всего. -->
            <Rectangle x:Name="ErrorFlash" Width="280" Height="280" Fill="#E01B2E" Opacity="0" />
        </Canvas>
    </Viewbox>
</UserControl>
