<UserControl x:Class="ZprtNextGen.App.Controls.MeditationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="240" d:DesignHeight="240">
    <UserControl.Resources>
        <!-- Stopped: breath 0→-3→0, 4 s, SineEase, forever. Static: halo 0.18, rays 0, lift 0, flash 0. -->
        <Storyboard x:Key="StoppedStoryboard">
            <DoubleAnimation Storyboard.TargetName="BreathTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-3" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Connecting: breath 0→-2→0, 1.6 s; aura opacity pulse 0.25↔0.55, 1 s autoreverse. -->
        <Storyboard x:Key="ConnectingStoryboard">
            <DoubleAnimation Storyboard.TargetName="BreathTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-2" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuraGlow" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.55" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>

        <!-- Connected: lift 0→-52 (1.2 s, CubicEase EaseOut), scale 1→1.04,
             bob -52↔-58 (3 s, forever), halo colour #E01B2E→#FFC65C and opacity 0.18→0.85,
             aura 0.12→0.8, rays 0→0.7 and rotate 0→360 over 24 s forever,
             particles fade+rise over 2.5 s with 0.2 s offset per index, repeat forever. -->
        <Storyboard x:Key="ConnectedStoryboard">
            <DoubleAnimation Storyboard.TargetName="LiftTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-52" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.04" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.04" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="BreathTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-6" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ColorAnimation Storyboard.TargetName="HaloDiamond"
                            Storyboard.TargetProperty="(Path.Stroke).(SolidColorBrush.Color)"
                            From="#E01B2E" To="#FFC65C" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="HaloDiamond" Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0.85" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="AuraGlow" Storyboard.TargetProperty="Opacity"
                             From="0.12" To="0.8" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="RaysGroup" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.7" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="RaysRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:24" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Particle01" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="Particle01Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="Particle02" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="Particle02Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="Particle03" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.6" />
            <DoubleAnimation Storyboard.TargetName="Particle03Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.6" />
            <DoubleAnimation Storyboard.TargetName="Particle04" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="Particle04Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="Particle05" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1" />
            <DoubleAnimation Storyboard.TargetName="Particle05Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1" />
            <DoubleAnimation Storyboard.TargetName="Particle06" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="Particle06Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="Particle07" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.4" />
            <DoubleAnimation Storyboard.TargetName="Particle07Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.4" />
            <DoubleAnimation Storyboard.TargetName="Particle08" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="Particle08Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="Particle09" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="Particle09Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="Particle10" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:2" />
            <DoubleAnimation Storyboard.TargetName="Particle10Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:2" />
            <DoubleAnimation Storyboard.TargetName="Particle11" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:2.2" />
            <DoubleAnimation Storyboard.TargetName="Particle11Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:2.2" />
            <DoubleAnimation Storyboard.TargetName="Particle12" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.9" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:2.4" />
            <DoubleAnimation Storyboard.TargetName="Particle12Transform" Storyboard.TargetProperty="Y"
                             From="0" To="-150" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:2.4" />
        </Storyboard>

        <!-- Error: flash 0→0.35→0 over 0.5 s; lift/scale return to 0 over 0.4 s; rays 0. -->
        <Storyboard x:Key="ErrorStoryboard">
            <DoubleAnimation Storyboard.TargetName="ErrorFlash" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.35" Duration="0:0:0.25" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="LiftTransform" Storyboard.TargetProperty="Y"
                             To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="RaysGroup" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="RaysRotate" Storyboard.TargetProperty="Angle"
                             To="0" Duration="0:0:0.4" />
        </Storyboard>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="240" Height="240" Background="#000000">
            <!-- Rays (back layer): 12 lines from center to radius 105, rotated as a group. -->
            <Canvas x:Name="RaysGroup" Opacity="0">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="RaysRotate" CenterX="120" CenterY="120" Angle="0" />
                </Canvas.RenderTransform>
                <Line X1="120" Y1="120" X2="225" Y2="120" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="210.9" Y2="172.5" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="172.5" Y2="210.9" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="120" Y2="225" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="67.5" Y2="210.9" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="29.1" Y2="172.5" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="15" Y2="120" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="29.1" Y2="67.5" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="67.5" Y2="29.1" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="120" Y2="15" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="172.5" Y2="29.1" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
                <Line X1="120" Y1="120" X2="210.9" Y2="67.5" Stroke="#FFC65C" StrokeThickness="1" Opacity="0" />
            </Canvas>

            <!-- Aura glow: 150×150 centered, radial gradient red→transparent. -->
            <Ellipse x:Name="AuraGlow" Width="150" Height="150" Canvas.Left="45" Canvas.Top="45" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#E01B2E" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Figure: line-art stroke #FF3B4E, animated via FigureGroup transform. -->
            <Canvas x:Name="FigureGroup">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="LiftTransform" Y="0" />
                        <TranslateTransform x:Name="BreathTransform" Y="0" />
                        <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" CenterX="120" CenterY="120" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Head: ellipse center (120,74), r 16. -->
                <Ellipse Width="32" Height="32" Canvas.Left="104" Canvas.Top="58"
                         Stroke="#FF3B4E" StrokeThickness="3" StrokeLineJoin="Round" />

                <!-- Torso. -->
                <Path Data="M96,96 C104,90 136,90 144,96 L136,150 C128,158 112,158 104,150 Z"
                      Stroke="#FF3B4E" StrokeThickness="3" StrokeLineJoin="Round" />

                <!-- Arms. -->
                <Path Data="M99,104 C86,116 78,140 76,156"
                      Stroke="#FF3B4E" StrokeThickness="3" StrokeLineJoin="Round" />
                <Path Data="M141,104 C154,116 162,140 164,156"
                      Stroke="#FF3B4E" StrokeThickness="3" StrokeLineJoin="Round" />

                <!-- Knees / hands: ellipses r 5 at (76,158) and (164,158). -->
                <Ellipse Width="10" Height="10" Canvas.Left="71" Canvas.Top="153"
                         Stroke="#FF3B4E" StrokeThickness="3" StrokeLineJoin="Round" />
                <Ellipse Width="10" Height="10" Canvas.Left="159" Canvas.Top="153"
                         Stroke="#FF3B4E" StrokeThickness="3" StrokeLineJoin="Round" />

                <!-- Crossed legs. -->
                <Path Data="M78,168 C96,184 144,184 162,168"
                      Stroke="#FF3B4E" StrokeThickness="3" StrokeLineJoin="Round" />
                <Path Data="M92,172 C108,160 132,160 148,172"
                      Stroke="#FF3B4E" StrokeThickness="3" StrokeLineJoin="Round" />

                <!-- Inner detail: shoulder arc and chest line. -->
                <Path Data="M98,110 C108,110 132,110 142,110"
                      Stroke="#EDEDED" StrokeThickness="1.5" Opacity="0.45" />
                <Path Data="M120,98 L120,132"
                      Stroke="#EDEDED" StrokeThickness="1.5" Opacity="0.45" />
            </Canvas>

            <!-- Halo diamond: animated colour and opacity (brush set inline, not in resources). -->
            <Path x:Name="HaloDiamond" Data="M120,20 L212,120 L120,220 L28,120 Z"
                  Stroke="#E01B2E" StrokeThickness="2" Opacity="0.18" />

            <!-- Particles: 12 diamonds on an arc, opacity 0, animated in Connected storyboard. -->
            <Canvas x:Name="Particles">
                <Path x:Name="Particle01" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="71.1" Canvas.Top="57.2">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle01Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle02" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="76.1" Canvas.Top="47.1">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle02Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle03" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="83.6" Canvas.Top="37.9">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle03Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle04" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="92.4" Canvas.Top="30.9">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle04Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle05" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="103.1" Canvas.Top="25.8">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle05Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle06" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="114.6" Canvas.Top="23.3">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle06Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle07" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="125.4" Canvas.Top="23.3">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle07Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle08" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="136.9" Canvas.Top="25.8">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle08Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle09" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="147.6" Canvas.Top="30.9">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle09Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle10" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="156.4" Canvas.Top="37.9">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle10Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle11" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="163.9" Canvas.Top="47.1">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle11Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Particle12" Data="M0,-4 L4,0 L0,4 L-4,0 Z" Fill="#FFFFFF" Opacity="0"
                      Canvas.Left="168.9" Canvas.Top="57.2">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="Particle12Transform" Y="0" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>

            <!-- Error flash: full canvas, red, on top. -->
            <Rectangle x:Name="ErrorFlash" Width="240" Height="240" Fill="#E01B2E" Opacity="0" />
        </Canvas>
    </Viewbox>
</UserControl>
