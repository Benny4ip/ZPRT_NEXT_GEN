<Window x:Class="ZprtNextGen.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ZprtNextGen.App.Converters"
        xmlns:presets="clr-namespace:ZprtNextGen.Core.Presets;assembly=ZprtNextGen.Core"
        mc:Ignorable="d"
        Title="РќР°СЃС‚СЂРѕР№РєРё"
        Width="760" Height="820"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DarkWindow}"
        Loaded="OnLoaded">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,8,12,8" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <ScrollViewer Margin="16" Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="700">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="РќР°СЃС‚СЂРѕР№РєРё" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource Brush.Text}" />
        <TextBlock Grid.Column="1" Text="{Binding SaveStatus}" VerticalAlignment="Center"
                   Foreground="{StaticResource Brush.TextMuted}" FontSize="12" />
      </Grid>

      <!-- РџР»Р°С€РєР° В«РЅСѓР¶РµРЅ РїРµСЂРµР·Р°РїСѓСЃРє РѕР±С…РѕРґР°В». -->
      <Border Background="#241A05" BorderBrush="#6B5320" BorderThickness="1" CornerRadius="10"
              Padding="14,10" Margin="0,0,0,12"
              Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Р§С‚РѕР±С‹ РїСЂРёРјРµРЅРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ, РїРµСЂРµР·Р°РїСѓСЃС‚Рё РѕР±С…РѕРґ."
                     Foreground="#F5C75C" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚СЊ" Style="{StaticResource SmallButton}"
                  Command="{Binding RestartConnectionCommand}" Margin="12,0,0,0" />
        </Grid>
      </Border>

      <!-- 1. РљР°Рє РїРѕРґРєР»СЋС‡Р°С‚СЊСЃСЏ -->
      <Border Style="{StaticResource Card}">
        <StackPanel Margin="4">
          <TextBlock Text="РљР°Рє РїРѕРґРєР»СЋС‡Р°С‚СЊСЃСЏ" Style="{StaticResource SectionTitle}" />

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="РђРІС‚РѕРјР°С‚РёС‡РµСЃРєРё РїРѕРґР±РёСЂР°С‚СЊ Р»СѓС‡С€РёР№ РѕР±С…РѕРґ"
                       Style="{StaticResource RowLabel}" />
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding IsAutoMode, Mode=TwoWay}"
                          VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="{Binding AutoModeHint}" Style="{StaticResource Muted}" Margin="0,0,0,10" />

          <Grid Margin="0,0,0,4"
                Visibility="{Binding IsAutoMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Р РµРєРѕРјРµРЅРґСѓРµС‚СЃСЏ. РђРІС‚РѕРїРѕРґР±РѕСЂ СѓР¶Рµ РЅР°СЃС‚СЂРѕРµРЅ вЂ” РїСЂРѕСЃС‚Рѕ РІРєР»СЋС‡Рё РѕР±С…РѕРґ РЅР° РіР»Р°РІРЅРѕРј СЌРєСЂР°РЅРµ."
                       Style="{StaticResource Muted}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Р СѓС‡РЅРѕР№ РѕР±С…РѕРґ:" Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
            <ComboBox MinWidth="260"
                      ItemsSource="{Binding ManualPresets}"
                      SelectedItem="{Binding SelectedManualPreset, Mode=TwoWay}"
                      DisplayMemberPath="Name">
              <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                  <Setter Property="IsEnabled" Value="False" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAutoMode}" Value="False">
                      <Setter Property="IsEnabled" Value="True" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ComboBox.Style>
            </ComboBox>
          </StackPanel>

          <TextBlock Text="{Binding CurrentProfileText}" Style="{StaticResource Muted}" Margin="0,0,0,12" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="РџСЂРѕС‚РµСЃС‚РёСЂРѕРІР°С‚СЊ Р°Р»СЊС‚С‹" Command="{Binding TestAllPresetsCommand}"
                    Style="{StaticResource SmallButton}" MinWidth="150" />
            <Button Content="РћСЃС‚Р°РЅРѕРІРёС‚СЊ" Command="{Binding CancelPresetTestCommand}"
                    Style="{StaticResource SmallButton}" MinWidth="100" Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock Text="РџСЂРѕРІРµСЂРёРј РІСЃРµ РѕР±С…РѕРґС‹ Рё РїРѕРєР°Р¶РµРј, РіРґРµ СЂР°Р±РѕС‚Р°СЋС‚ YouTube Рё Discord. РўРµРєСѓС‰РёР№ РѕР±С…РѕРґ Р±СѓРґРµС‚ РІСЂРµРјРµРЅРЅРѕ РІС‹РєР»СЋС‡РµРЅ."
                     Style="{StaticResource Muted}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding PresetTestStatus}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
          <ProgressBar Value="{Binding PresetTestProgress, Mode=OneWay}" Height="6" Margin="0,0,0,8"
                       Visibility="{Binding IsTestingPresets, Converter={StaticResource BoolToVisibilityConverter}}" />

          <ItemsControl ItemsSource="{Binding PresetTestResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,6" CornerRadius="6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding YoutubeText}"
                               Foreground="{Binding YoutubeOk, Converter={StaticResource BoolToBrushConverter}}"
                               FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DiscordText}"
                               Foreground="{Binding DiscordOk, Converter={StaticResource BoolToBrushConverter}}"
                               FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding PingText}"
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                      <Button Content="РСЃРїРѕР»СЊР·РѕРІР°С‚СЊ" Style="{StaticResource SmallButton}"
                              Command="{Binding DataContext.UsePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding PresetId}" />
                      <Button Content="РЎРґРµР»Р°С‚СЊ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРёРј" Style="{StaticResource SmallButton}"
                              Margin="6,0,0,0"
                              Command="{Binding DataContext.MakeAutomaticCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding PresetId}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 2. РРіСЂРѕРІРѕР№ РїСЂРѕС„РёР»СЊ -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel Margin="4">
          <TextBlock Text="РРіСЂРѕРІРѕР№ РїСЂРѕС„РёР»СЊ" Style="{StaticResource SectionTitle}" />

          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="РЈР»СѓС‡С€Р°РµС‚ СЃРѕРµРґРёРЅРµРЅРёРµ РІ РёРіСЂР°С…" Style="{StaticResource RowLabel}" />
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding IsGameProfileEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="Р’РєР»СЋС‡Р°Р№, РµСЃР»Рё РёРіСЂР°РµС€СЊ." Style="{StaticResource Muted}" Margin="0,0,0,8" />

          <Expander Header="Р”РѕРїРѕР»РЅРёС‚РµР»СЊРЅРѕ" Style="{StaticResource SettingsExpander}">
            <StackPanel>
              <TextBlock Text="РўРѕРЅРєР°СЏ РЅР°СЃС‚СЂРѕР№РєР° С„РёР»СЊС‚СЂР° (РєРѕРіРґР° РёРіСЂРѕРІРѕР№ РїСЂРѕС„РёР»СЊ РІС‹РєР»СЋС‡РµРЅ)" Style="{StaticResource Muted}"
                         Margin="0,0,0,8" />
              <ComboBox Style="{StaticResource DarkComboBox}" MinWidth="160" HorizontalAlignment="Left"
                        SelectedValue="{Binding DetailedGameFilter, Mode=TwoWay}"
                        SelectedValuePath="Tag" DisplayMemberPath="Content">
                <ComboBoxItem Content="Р’СЃРµ" Tag="{x:Static presets:GameFilterMode.All}" />
                <ComboBoxItem Content="TCP" Tag="{x:Static presets:GameFilterMode.Tcp}" />
                <ComboBoxItem Content="UDP" Tag="{x:Static presets:GameFilterMode.Udp}" />
                <ComboBoxItem Content="Р’С‹РєР»СЋС‡РµРЅ" Tag="{x:Static presets:GameFilterMode.Disabled}" />
              </ComboBox>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>

      <!-- 3. РњРѕРё РїСЂРµСЃРµС‚С‹ -->
      <Expander Header="РњРѕРё РїСЂРµСЃРµС‚С‹" Style="{StaticResource SettingsExpander}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="РЎРІРѕРё Р°СЂРіСѓРјРµРЅС‚С‹ winws. РџРѕРґРґРµСЂР¶РёРІР°СЋС‚СЃСЏ РїР»РµР№СЃС…РѕР»РґРµСЂС‹ {{GameFilterTCP}} Рё {{GameFilterUDP}}."
                     Style="{StaticResource Muted}" Margin="0,0,0,10" />

          <ItemsControl ItemsSource="{Binding CustomPresets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="РР·РјРµРЅРёС‚СЊ" Style="{StaticResource SmallButton}"
                            Click="OnEditCustomPreset" CommandParameter="{Binding}" />
                    <Button Content="РЈРґР°Р»РёС‚СЊ" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                            Click="OnDeleteCustomPreset" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Р”РѕР±Р°РІРёС‚СЊ РїСЂРµСЃРµС‚" Style="{StaticResource SmallButton}"
                  HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnAddCustomPreset" />
        </StackPanel>
      </Expander>

      <!-- 4. Р—Р°РїСѓСЃРє Рё С‚СЂРµР№ -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel Margin="4">
          <TextBlock Text="Р—Р°РїСѓСЃРє Рё С‚СЂРµР№" Style="{StaticResource SectionTitle}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Р—Р°РїСѓСЃРєР°С‚СЊ РІРјРµСЃС‚Рµ СЃ Windows" Style="{StaticResource RowLabel}" />
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding IsAutostartEnabled, Mode=OneWay}"
                          Command="{Binding ToggleAutostartCommand}"
                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                          VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="РЎС‚Р°СЂС‚СѓРµС‚ СЃРІС‘СЂРЅСѓС‚С‹Рј РІ С‚СЂРµР№ Рё СЃСЂР°Р·Сѓ РІРєР»СЋС‡Р°РµС‚ РїРѕСЃР»РµРґРЅРёР№ СЂР°Р±РѕС‡РёР№ РѕР±С…РѕРґ."
                     Style="{StaticResource Muted}" Margin="0,0,0,8" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="РЎРІРѕСЂР°С‡РёРІР°С‚СЊ РІ С‚СЂРµР№ РїСЂРё Р·Р°РєСЂС‹С‚РёРё" Style="{StaticResource RowLabel}" />
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                          VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="РЈРјРµРЅСЊС€РёС‚СЊ Р°РЅРёРјР°С†РёСЋ" Style="{StaticResource RowLabel}" />
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                          VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 5. Р”РІРёР¶РѕРє Рё РѕР±РЅРѕРІР»РµРЅРёСЏ -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel Margin="4">
          <TextBlock Text="Р”РІРёР¶РѕРє Рё РѕР±РЅРѕРІР»РµРЅРёСЏ" Style="{StaticResource SectionTitle}" />

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding EnginePath, Mode=OneWay}" IsReadOnly="True"
                     Style="{StaticResource DarkTextBox}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="РћР±Р·РѕСЂвЂ¦" Click="OnBrowseEngine"
                    Style="{StaticResource SmallButton}" Margin="10,0,0,0" MinWidth="90" />
          </Grid>
          <TextBlock Text="{Binding EngineStatusText}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
          <TextBlock Text="{Binding EngineVersion, StringFormat='Р’РµСЂСЃРёСЏ РґРІРёР¶РєР°: {0}'}"
                     Style="{StaticResource Muted}" Margin="0,0,0,10" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="РџСЂРѕРІРµСЂРёС‚СЊ РѕР±РЅРѕРІР»РµРЅРёРµ" Command="{Binding CheckUpdatesCommand}"
                    Style="{StaticResource SmallButton}" MinWidth="140" />
            <Button Content="РћР±РЅРѕРІРёС‚СЊ РґРІРёР¶РѕРє" Command="{Binding UpdateEngineCommand}"
                    Style="{StaticResource SmallButton}" MinWidth="130" Margin="8,0,0,0" />
            <Button Content="РћР±РЅРѕРІРёС‚СЊ РїСЂРѕРіСЂР°РјРјСѓ" Command="{Binding UpdateAppCommand}"
                    Style="{StaticResource SmallButton}" MinWidth="140" Margin="8,0,0,0" />
            <Button Content="GitHub releases" Command="{Binding OpenGitHubCommand}"
                    Style="{StaticResource SmallButton}" MinWidth="110" Margin="8,0,0,0" />
          </StackPanel>

          <TextBlock Text="Р”РІРёР¶РѕРє РІСЃС‚СЂРѕРµРЅ РІ portable-РІРµСЂСЃРёСЋ. РћР±РЅРѕРІРёС‚Рµ РїСЂРѕРіСЂР°РјРјСѓ С†РµР»РёРєРѕРј."
                     Style="{StaticResource Muted}" Margin="0,0,0,6"
                     Visibility="{Binding IsPortable, Converter={StaticResource BoolToVisibilityConverter}}" />
          <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
          <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Height="6"
                       Visibility="{Binding IsMaintenanceBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
      </Border>

      <!-- 6. Р”РёР°РіРЅРѕСЃС‚РёРєР° -->
      <Expander Header="Р”РёР°РіРЅРѕСЃС‚РёРєР°" Style="{StaticResource SettingsExpander}" Margin="0,12,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="РџСЂРѕРІРµСЂРёС‚СЊ СЃРІСЏР·СЊ" Command="{Binding CheckConnectivityCommand}"
                    Style="{StaticResource SmallButton}" MinWidth="130" />
            <Button Content="РћС‚РєСЂС‹С‚СЊ РїР°РїРєСѓ Р»РѕРіРѕРІ" Command="{Binding OpenLogsCommand}"
                    Style="{StaticResource SmallButton}" Margin="8,0,0,0" MinWidth="140" />
            <Button Content="РЎРєРѕРїРёСЂРѕРІР°С‚СЊ Р»РѕРі" Click="OnCopyLog"
                    Style="{StaticResource SmallButton}" Margin="8,0,0,0" MinWidth="120" />
          </StackPanel>

          <TextBlock Text="{Binding ConnectivityStatus}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding ConnectivityRows}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{Binding Success, Converter={StaticResource BoolToBrushConverter}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource Brush.Text}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding LatencyText}" Style="{StaticResource Muted}"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="РџРѕР»РЅС‹Р№ СЃР±СЂРѕСЃ Discord (СЃ РІС‹С…РѕРґРѕРј РёР· Р°РєРєР°СѓРЅС‚Р°)" Style="{StaticResource RowLabel}"
                     Margin="0,0,0,6" />
          <Button Content="РџРѕР»РЅС‹Р№ СЃР±СЂРѕСЃ Discord" Command="{Binding FullDiscordResetCommand}"
                  Style="{StaticResource SmallButton}" HorizontalAlignment="Left" MinWidth="180"
                  Foreground="#FF6B6B" BorderBrush="#6B2020" />
          <TextBlock Text="{Binding DiscordStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
        </StackPanel>
      </Expander>

      <!-- 7. Рћ РїСЂРѕРіСЂР°РјРјРµ -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <Grid Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="ZPRT NEXT GEN" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="{Binding AppVersion, StringFormat='Р’РµСЂСЃРёСЏ {0}'}" Style="{StaticResource Muted}"
                       Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Рћ РїСЂРѕРіСЂР°РјРјРµ" Click="OnAbout" Style="{StaticResource SmallButton}"
                    MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Р—Р°РєСЂС‹С‚СЊ" Click="OnClose" Style="{StaticResource SmallButton}" MinWidth="90" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>

